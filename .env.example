# ==========================================================
# OPERATION PRAHAAR AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME="OPERATION PRAHAAR AI"
APP_VERSION=1.0.0

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=prahaar-prototype-dev-secret-key-change-in-production-2026

# Database Configuration (SQLite for ₹0 zero-cost local laptop operation)
DATABASE_URL=sqlite:///./prahaar.db

# Edge Device Simulation Configuration
EDGE_DEVICE_ID=EDGE-IND-DELHI-001
EDGE_LOCATION="Sector 4 - Public Transit Hub"
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
EDGE_HEARTBEAT_INTERVAL_SECONDS=10
EDGE_FRAME_SAMPLING_RATE=5

# Computer Vision & Safety Analytics Thresholds
CROWD_CONGESTION_THRESHOLD=0.75
RESTRICTED_ZONE_INTRUSION_ENABLED=True
MAX_FRAME_BUFFER_SIZE=30

# Responsible AI & Privacy Settings (Mandatory)
PRIVACY_PRESERVING_MODE=True
ENABLE_FACIAL_RECOGNITION=False
ENABLE_BIOMETRIC_WATCHLISTS=False
REQUIRE_HUMAN_VERIFICATION_FOR_ESCALATION=True
AUDIT_LOG_RETENTION_DAYS=90
RAW_FRAME_PERSISTENCE=False
